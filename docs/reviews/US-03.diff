+  delayMs = 1500,
+): Promise<{ fixture: ComponentFixture<Summary>; el: HTMLElement; set: ReturnType<typeof vi.spyOn> }> {
+  const get = vi.fn((path: string) => {
+    if (path.startsWith('/countries')) return of({ data: [countryRaw] });

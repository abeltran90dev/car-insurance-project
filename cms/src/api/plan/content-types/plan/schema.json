{
  "kind": "collectionType",
  "collectionName": "plans",
  "info": { "singularName": "plan", "pluralName": "plans", "displayName": "Plan" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true },
    "shortDescription": { "type": "text" },
    "basePrice": { "type": "decimal", "required": true },
    "currency": { "type": "string" },
    "order": { "type": "integer" },
    "recommended": { "type": "boolean", "default": false },
    "active": { "type": "boolean", "default": true },
    "coverages": { "type": "component", "component": "plan.coverage", "repeatable": true },
    "benefits": { "type": "component", "component": "plan.benefit", "repeatable": true },
    "country": { "type": "relation", "relation": "manyToOne", "target": "api::country.country" }
  }
}

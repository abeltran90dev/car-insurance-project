{
  "kind": "collectionType",
  "collectionName": "countries",
  "info": { "singularName": "country", "pluralName": "countries", "displayName": "Country" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "code": { "type": "string", "required": true, "unique": true, "regex": "^[A-Z]{2}$" },
    "name": { "type": "string", "required": true },
    "numberLocale": { "type": "string", "required": true },
    "currency": { "type": "string", "required": true },
    "legalAge": { "type": "integer", "required": true },
    "termsTitle": { "type": "string" },
    "termsBody": { "type": "text" },
    "copy": { "type": "component", "component": "shared.copy-entry", "repeatable": true }
  }
}

{
  "kind": "collectionType",
  "collectionName": "form_fields",
  "info": { "singularName": "form-field", "pluralName": "form-fields", "displayName": "Form field" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "key": { "type": "string", "required": true },
    "label": { "type": "string", "required": true },
    "type": { "type": "enumeration", "enum": ["text", "number", "select", "date", "checkbox"], "required": true },
    "required": { "type": "boolean", "default": false },
    "helpText": { "type": "string" },
    "errorMessage": { "type": "string" },
    "placeholder": { "type": "string" },
    "order": { "type": "integer", "required": true },
    "group": { "type": "enumeration", "enum": ["policyholder", "vehicle"], "required": true },
    "maskInSummary": { "type": "boolean", "default": false },
    "options": { "type": "component", "component": "form.option", "repeatable": true },
    "validations": { "type": "component", "component": "form.validation-rule", "repeatable": true },
    "country": { "type": "relation", "relation": "manyToOne", "target": "api::country.country" }
  }
}

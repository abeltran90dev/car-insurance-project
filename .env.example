# Copy to .env (gitignored) only if you want to override defaults. Placeholders only.
# Leave the Strapi secrets empty: the cms container generates them on first start
# and persists them in the cms_data volume.
FRONTEND_ORIGIN=http://localhost:4200
SEED_ON_BOOT=true
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
